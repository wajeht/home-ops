{
	auto_https off
	admin off
	persist_config off
}

# Preserve the legacy X-Bypass-Key behavior while keeping oauth2-proxy as the
# normal authentication backend. These listeners are Docker-network-only.
:4181 {
	@health path /health
	@bypass header X-Bypass-Key {$X_BYPASS_KEY}

	handle @health {
		respond 200
	}

	handle @bypass {
		respond 202
	}

	handle {
		route {
			forward_auth oauth2-admin:4180 {
				uri /
				copy_headers X-Auth-Request-User X-Auth-Request-Email
			}

			header X-Auth-Request-User {http.request.header.X-Auth-Request-User}
			header X-Auth-Request-Email {http.request.header.X-Auth-Request-Email}
			respond 202
		}
	}
}

:4182 {
	@health path /health
	@bypass header X-Bypass-Key {$X_BYPASS_KEY}

	handle @health {
		respond 200
	}

	handle @bypass {
		respond 202
	}

	handle {
		route {
			forward_auth oauth2-media:4180 {
				uri /
				copy_headers X-Auth-Request-User X-Auth-Request-Email
			}

			header X-Auth-Request-User {http.request.header.X-Auth-Request-User}
			header X-Auth-Request-Email {http.request.header.X-Auth-Request-Email}
			respond 202
		}
	}
}
