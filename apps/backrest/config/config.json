  "plans": [
    {
      "id": "bang",
      "repo": "bang",
      "paths": ["/source/bang/.bang.bak"],
      "schedule": { "cron": "30 1 * * *", "clock": "CLOCK_LOCAL" },
      "retention": {
        "policyTimeBucketed": { "daily": 7, "weekly": 4, "monthly": 6 }
      },
      "hooks": [
        {
          "conditions": ["CONDITION_SNAPSHOT_START"],
          "onError": "ON_ERROR_CANCEL",
          "actionCommand": {
            "command": "sqlite3 /source/bang/db.sqlite -cmd \".timeout 30000\" \".backup /source/bang/.bang.bak\""
          }
        },
        {
          "conditions": ["CONDITION_SNAPSHOT_END"],
          "actionCommand": {
            "command": "rm -f /source/bang/.bang.bak"
          }
        },
        {
          "conditions": ["CONDITION_SNAPSHOT_SUCCESS"],
          "onError": "ON_ERROR_IGNORE",
          "actionShoutrrr": {
            "shoutrrrUrl": "ntfy://ntfy/borgmatic?scheme=http&title=bang+backup+complete&priority=Min&tags=white_check_mark",
            "template": "bang backup finished"
          }
        },
        {
          "conditions": ["CONDITION_SNAPSHOT_ERROR"],
          "onError": "ON_ERROR_IGNORE",
          "actionShoutrrr": {
            "shoutrrrUrl": "ntfy://ntfy/borgmatic?scheme=http&title=bang+backup+FAILED&priority=Max&tags=skull",
            "template": "bang backup failed{{ if .Error }}: {{ .Error }}{{ end }}"
          }
        }
      ]
    },
