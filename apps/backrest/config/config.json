{
  "instance": "homeops",
  "version": 6,
  "auth": {
    "disabled": true
  },
  "repos": [
    {
      "id": "bang",
      "uri": "/repos/bang",
      "password": "",
      "autoInitialize": true,
      "prunePolicy": {
        "schedule": { "cron": "0 4 * * 0" },
        "maxUnusedPercent": 10
      },
      "checkPolicy": {
        "schedule": { "cron": "0 5 * * 0" },
        "structureOnly": true
      }
    }
  ],
  "plans": [
    {
      "id": "bang",
      "repo": "bang",
      "paths": ["/tmp/dumps/bang.bak"],
      "schedule": {
        "cron": "30 1 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 7,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [
        {
          "conditions": ["CONDITION_SNAPSHOT_START"],
          "onError": "ON_ERROR_CANCEL",
          "actionCommand": {
            "command": "sh -c 'mkdir -p /tmp/dumps && docker exec bang sqlite3 /usr/src/app/dist/src/db/sqlite/db.sqlite \".backup /tmp/bang.bak\" && docker cp bang:/tmp/bang.bak /tmp/dumps/bang.bak'"
          }
        },
        {
          "conditions": ["CONDITION_SNAPSHOT_END"],
          "actionCommand": {
            "command": "sh -c 'rm -f /tmp/dumps/bang.bak && docker exec bang rm -f /tmp/bang.bak'"
          }
        }
      ]
    }
  ]
}
