{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wajeht/renovate-config"],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "username": "wajeht",
      "password": "{{ secrets.GH_TOKEN }}"
    },
    {
      "matchHost": "docker.io",
      "hostType": "docker",
      "username": "typicalwavefix",
      "password": "{{ secrets.DOCKER_HUB_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Ignore apps excluded from docker-cd deployment",
      "matchFileNames": [
        "/(^|/)apps\\/(adguard|authelia|autobrr|bitmagnet|changedetection|cleanuparr|glitchtip|huntarr|hydra-server|linx|miniflux|paperless-ngx|plausible|portainer|readmeabook|recyclarr|searxng|stirling-pdf|tautulli|walker|zipline)\\//"
      ],
      "enabled": false
    },
    {
      "enabled": false,
      "matchPackageNames": ["/^ghcr\\.io/wajeht//"]
    },
    {
      "matchPackageNames": ["ghcr.io/diced/zipline"],
      "enabled": false
    }
  ]
}
