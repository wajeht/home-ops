{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wajeht/renovate-config"],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "username": "wajeht",
      "password": "{{ secrets.GH_TOKEN }}"
    },
    {
      "matchHost": "docker.io",
      "hostType": "docker",
      "username": "typicalwavefix",
      "password": "{{ secrets.DOCKER_HUB_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Own images deploy via their own pipelines, not Renovate",
      "enabled": false,
      "matchPackageNames": ["/^ghcr\\.io/wajeht//"]
    },
    {
      "description": "Zipline upstream tags are not semver-friendly",
      "matchPackageNames": ["ghcr.io/diced/zipline"],
      "enabled": false
    },
    {
      "description": "Pin LinuxServer images to stable -lsNNN tags; reject unstable/develop/nightly/development channels",
      "matchPackageNames": ["/^linuxserver\\//"],
      "allowedVersions": "/^v?\\d[\\w.-]*-ls\\d+$/"
    }
  ]
}
