{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wajeht/renovate-config"],
  "ignoreDeps": ["ghcr.io/wajeht/regexr", "ghcr.io/wajeht/roadmap-for-bjj", "ghcr.io/wajeht/bjj"],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "username": "wajeht",
      "password": "{{ secrets.GH_TOKEN }}"
    },
    {
      "matchHost": "docker.io",
      "hostType": "docker",
      "username": "typicalwavefix",
      "password": "{{ secrets.DOCKER_HUB_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "enabled": true,
      "matchPackageNames": ["/^ghcr\\.io/wajeht//"]
    },
    {
      "matchPackageNames": ["ghcr.io/immich-app/postgres", "postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/^linuxserver//"],
      "rollbackPrs": false
    },
    {
      "description": "Keep SABnzbd on stable numeric release tags; exclude unstable and prerelease builds.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["linuxserver/sabnzbd"],
      "versioning": "docker",
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
    }
  ]
}
