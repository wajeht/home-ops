{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wajeht/renovate-config"],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "username": "wajeht",
      "password": "{{ secrets.GH_TOKEN }}"
    },
    {
      "matchHost": "docker.io",
      "hostType": "docker",
      "username": "typicalwavefix",
      "password": "{{ secrets.DOCKER_HUB_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Ignore apps excluded from docker-cd deployment",
      "matchFileNames": [
        "/(^|/)apps\\/(adguard|audiobookshelf|authelia|autobrr|bitmagnet|changedetection|cleanuparr|code-server|excalidraw|frigate|glitchtip|huntarr|hydra-server|it-tools|listenarr|linx|miniflux|paperless-ngx|plausible|portainer|readmeabook|recyclarr|scrypted|searxng|speedtest|stirling-pdf|tautulli|vaultwarden|walker|zipline)\\//"
      ],
      "enabled": false
    },
    {
      "enabled": false,
      "matchPackageNames": ["/^ghcr\\.io/wajeht//"]
    },
    {
      "matchPackageNames": ["ghcr.io/diced/zipline"],
      "enabled": false
    },
    {
      "description": "Pin LinuxServer images to stable -lsNNN tags; ignore unstable/develop/nightly/development channels",
      "matchPackageNames": ["/^linuxserver\\//"],
      "ignoreVersions": [
        "/^(unstable|develop|nightly)-/",
        "/-(unstable|develop|nightly|development)(-|$)/"
      ]
    }
  ]
}
